# Pulse Live Environment Configuration
# Copy this file to .env and adjust values for your platform.

# --- Model Configuration ---
MODEL_CHECKPOINT_PATH=./poc-notebooks/checkpoints_poc_retrieval_ft_transformer/best_model.pt
MODEL_NORM_PATH=
MODEL_COMBINATION_ID=0401

# --- Streaming Configuration ---
WINDOW_SECONDS=1.5
MIN_FRAMES=20
TARGET_FPS=15

# --- MinIO Object Storage ---
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=pulse-live

# --- Platform-Specific Library Paths (optional) ---
# Linux:  export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/path/to/libs"
# macOS:  export DYLD_LIBRARY_PATH="$DYLD_LIBRARY_PATH:/path/to/libs"
# Windows: Add to PATH via System Settings or:
#   set PATH=C:\path\to\libs;%PATH%
